      "questions": [
        {
          "qNum": "Q1",
          "topic": "'हाथ' से संबंधित मुहावरे एवं वाक्य-प्रयोग",
          "questionText": "<div class=\"q-block\">\n  <p>\"मगर किसी के आगे जाकर <u>हाथ नहीं पसारना</u> है।\" उपर्युक्त वाक्य में रेखांकित अंश मुहावरा है। ऐसे ही कुछ मुहावरे नीचे दिए गए हैं। इनका प्रयोग करते हुए वाक्य बनाइए- हाथ में आना, हाथ का मैल होना, हाथ से हाथ मिलाना, हाथ साफ करना, हाथ से निकल जाना, हाथ धो बैठना।</p>\n</div>",
          "hints": "'हाथ' से बने इन छह मुहावरों के अर्थ समझकर व्यावहारिक वाक्यों में प्रयोग कीजिए।",
          "solutions": "<div class=\"a-block\">\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 8px;\">\n    <tr><th style=\"border: 1px solid #d4c2a8; padding: 4px;\">मुहावरा</th><th style=\"border: 1px solid #d4c2a8; padding: 4px;\">अर्थ</th><th style=\"border: 1px solid #d4c2a8; padding: 4px;\">वाक्य प्रयोग</th></tr>\n    <tr><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">हाथ में आना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">प्राप्त होना / अधिकार में आना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">बरसों की कड़ी मेहनत के बाद आखिरकार सफलता उसके <em>हाथ में आ ही गई</em>।</td></tr>\n    <tr><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">हाथ का मैल होना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">तुच्छ या महत्वहीन वस्तु</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">ईमानदार व्यक्ति के लिए पैसा तो केवल <em>हाथ का मैल होता है</em>, असली धन तो चरित्र है।</td></tr>\n    <tr><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">हाथ से हाथ मिलाना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">सहयोग करना / एकजुट होना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">संकट के समय हमें <em>हाथ से हाथ मिलाकर</em> देश की प्रगति के लिए काम करना चाहिए।</td></tr>\n    <tr><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">हाथ साफ करना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">चुरा लेना / हड़प लेना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">भीड़भाड़ वाले बाज़ार में किसी चोर ने मेरे पर्स पर <em>हाथ साफ कर दिया</em>।</td></tr>\n    <tr><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">हाथ से निकल जाना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">नियंत्रण में न रहना / अवसर चूकना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">लापरवाही के कारण व्यापार का एक बहुत बड़ा अवसर उसके <em>हाथ से निकल गया</em>।</td></tr>\n    <tr><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">हाथ धो बैठना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">गँवा देना / नुकसान उठाना</td><td style=\"border: 1px solid #d4c2a8; padding: 4px;\">शेयर बाज़ार में लालच के कारण वह अपनी सारी जमा-पूँजी से <em>हाथ धो बैठा</em>।</td></tr>\n  </table>\n</div>"
        }
      ]
    }
  ]
