      <!-- Title -->
      <text x="270" y="24" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#333" text-anchor="middle">Market Equilibrium Graph</text>
      
      <!-- Coordinate Axes -->
      <line x1="70" y1="260" x2="470" y2="260" stroke="#333" stroke-width="1.8"/>
