      "questions": [
        {
          "qNum": "Q1",
          "topic": "ए.जी. गार्डिनर बनाम लेखक के विचार",
          "questionText": "<div class=\"q-block\">\n  <p>निबंध लेखन के विषय में ए.जी. गार्डिनर और लेखक के विचारों में क्या अंतर है?</p>\n</div>",
          "hints": "मानसिक स्फूर्ति और सहज प्रवाह बनाम गंभीर चिंतन व श्रम के अंतर को स्पष्ट कीजिए।",
          "solutions": "<div class=\"a-block\">\n  <ul>\n    <li><strong>ए.जी. गार्डिनर के विचार:</strong> वे मानते हैं कि लिखने की एक विशेष मानसिक स्थिति (आवेग और स्फूर्ति) होती है, जिसमें विषय गौण हो जाता है और लेखक के भाव (मनोभाव) अपने आप प्रवाहित होने लगते हैं।</li>\n    <li><strong>लेखक के विचार:</strong> लेखक का मानना है कि उसने कभी उस 'मानसिक स्थिति' का अनुभव नहीं किया है। उसे निबंध लिखने के लिए विषय के बारे में गंभीरता से सोचना पड़ता है, चिंता करनी पड़ती है और भारी परिश्रम करना पड़ता है।</li>\n  </ul>\n</div>"
        },
        {
          "qNum": "Q2",
          "topic": "वृद्ध और तरुण की असंतुष्टि के कारण",
          "questionText": "<div class=\"q-block\">\n  <p>लेखक के अनुसार वृद्ध और तरुण दोनों ही वर्तमान से असंतुष्ट रहते हैं, पर दोनों की असंतुष्टि के कारण भिन्न हैं। आपके विचार से उनकी असंतुष्टि के क्या-क्या कारण हो सकते हैं?</p>\n</div>",
          "hints": "अतीत के सुखद गौरव के मोह बनाम भविष्य के सुनहरे सपनों और क्रांति के दृष्टिकोण पर विचार कीजिए।",
          "solutions": "<div class=\"a-block\">\n  <ul>\n    <li><strong>वृद्धों की असंतुष्टि:</strong> वे अपनी युवावस्था और अतीत के गौरव (स्मृतियों) से दूर हो चुके होते हैं। उन्हें लगता है कि उनका 'अतीत' वर्तमान से कहीं अधिक सुखद था, इसलिए वे अतीत के संरक्षक बन जाते हैं और वर्तमान में उसी को देखना चाहते हैं।</li>\n    <li><strong>तरुणों (युवाओं) की असंतुष्टि:</strong> उनके लिए भविष्य उज्ज्वल होता है। वे संसार के कटु यथार्थ से दूर होते हैं और अपने सपनों (भविष्य) को वर्तमान में लागू करना चाहते हैं, इसलिए वे क्रांति के समर्थक होते हैं।</li>\n  </ul>\n</div>"
        },
        {
          "qNum": "Q3",
          "topic": "निबंध लेखन में आई कठिनाइयाँ",
          "questionText": "<div class=\"q-block\">\n  <p>नमिता और अमिता किन विषयों पर निबंध लिखवाना चाहती हैं? उनके द्वारा सुझाए गए विषयों पर निबंध लिखने में लेखक को क्या-क्या कठिनाइयाँ आईं?</p>\n</div>",
          "hints": "विषय की व्यापकता व संकीर्णता, पृष्ठ-सीमा और समय व संदर्भ-पुस्तकों के अभाव पर ध्यान दीजिए।",
          "solutions": "<div class=\"a-block\">\n  <ul>\n    <li><strong>विषय:</strong> नमिता 'दूर के ढोल सुहावने होते हैं' पर और अमिता 'समाज-सुधार' पर निबंध लिखवाना चाहती है।</li>\n    <li><strong>कठिनाइयाँ:</strong> \n      <br/>(i) 'दूर के ढोल सुहावने' जैसे छोटे विषय पर पूरे पाँच पेज कैसे लिखे जाएँ?\n      <br/>(ii) 'समाज-सुधार' जैसे अनंत काल से चले आ रहे विवादित और विशाल विषय को केवल पाँच पेज में कैसे समेटा जाए?\n      <br/>(iii) समय का अभाव (केवल दो घंटे) और सामग्री एकत्र करने के लिए पुस्तकालय/विश्वकोश का न होना।\n    </li>\n  </ul>\n</div>"
        },
        {
          "qNum": "Q4",
          "topic": "आदर्श निबंध की युक्तियाँ एवं व्यक्तिगत तैयारी",
          "questionText": "<div class=\"q-block\">\n  <p>निबंधशास्त्र के आचार्यों ने आदर्श निबंध लिखने की कौन-सी युक्तियाँ सुझाई हैं? आप किसी भी विषय पर निबंध लिखने से पहले किस तरह की तैयारी करते हैं?</p>\n</div>",
          "hints": "सामग्री, शैली, संक्षिप्तता, रूपरेखा और अपनी लेखन पद्धति का उल्लेख कीजिए।",
          "solutions": "<div class=\"a-block\">\n  <ul>\n    <li><strong>आचार्यों की युक्तियाँ:</strong> निबंध छोटा होना चाहिए। इसके दो प्रधान अंग हैं- सामग्री और शैली। लिखने से पहले सामग्री एकत्र करनी चाहिए (मनन/अध्ययन) और निबंध की एक 'रूपरेखा' तैयार करनी चाहिए। भाषा में प्रवाह होना चाहिए, वाक्य छोटे हों लेकिन एक-दूसरे से संबद्ध हों।</li>\n    <li><strong>मेरी तैयारी:</strong> (छात्र अपने विचार लिखें) मैं भी निबंध लिखने से पहले विषय का चुनाव करता हूँ, उससे संबंधित जानकारी (सामग्री) जुटाता हूँ, एक रूपरेखा (प्रस्तावना, मध्य भाग, उपसंहार) बनाता हूँ और फिर उसे अपनी भाषा में क्रमबद्ध रूप से लिखता हूँ।</li>\n  </ul>\n</div>"
        },
        {
          "qNum": "Q5",
          "topic": "अनुभव आधारित स्वच्छंद लेखन की उपयोगिता",
          "questionText": "<div class=\"q-block\">\n  <p>मानटेन ने \"जो कुछ देखा, सुना और अनुभव किया, उसी को अपने निबंधों में लिपिबद्ध कर दिया।\" निबंध लेखन के लिए देखने, सुनने और अनुभव करने की क्या उपयोगिता हो सकती है?</p>\n</div>",
          "hints": "सच्ची अनुभूति, उल्लास और पाठक के साथ भावनात्मक जुड़ाव के महत्व को रेखांकित कीजिए।",
          "solutions": "<div class=\"a-block\">\n  <p>निबंध लेखन में देखने, सुनने और अनुभव करने की सबसे बड़ी उपयोगिता यह है कि इससे निबंध में <strong>'सच्ची अनुभूति'</strong> और <strong>'सच्चे भावों की अभिव्यक्ति'</strong> आती है। जब लेखक स्वयं के अनुभव लिखता है, तो उसमें कृत्रिमता (बनावटीपन) नहीं होती, बल्कि उसका उल्लास झलकता है। इससे पाठक भी उस निबंध से भावनात्मक रूप से जुड़ जाता है, जो केवल किताबी ज्ञान (गंभीर तर्कपूर्ण विवेचना) से संभव नहीं है।</p>\n</div>"
        }
      ]
    },
